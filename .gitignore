__pycache__/
*.pyc

# 视频解析下载的 yt-dlp / ffmpeg 组件（源码运行时落在仓库根目录，体积大且可自动重下）
tools/

# 构建产物（exe 安装包）
build/
dist/
*.spec
_build_icon.ico

# 自检截图与设计稿渲染图（不上传仓库）
designs/verify/
designs/**/*.png

/_*.log
_build_manifest.xml

# 网站构建工具缓存（od 工具版本/画框缓存，非站点内容）
website/.file-versions/
website/.od-frames/
website/.od-skills/
website/*.artifact.json

# 截图自检输出（前后对比基线/报告，不上传仓库）
shots/

# 隔离工作树
.worktrees/

# 工具的临时工作目录（brainstorm 记录等，非源码）
.superpowers/

# Gradle / Kotlin 构建缓存（Android 端）
android/.kotlin/
android/.gradle/
android/build/
android/app/build/

# 性能审计工作区（perf-audit/）：脚本与原始测量数据入库，运行时临时目录不入库
perf-audit/tmp/
perf-audit/__pycache__/
# 截图自检的中间产物（前后对比用，不入库；需要时重跑 ZBOX_SHOT 生成）
perf-audit/shots_*/
perf-audit/cmp_*/
